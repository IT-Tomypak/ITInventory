# The bundle carries exactly these two secret-shaped values, and NEITHER is a
# secret. Everything in a static export is public. They are safe ONLY because
# Row Level Security in the database decides what they can reach.
#
# Do NOT add a service-role key, a Resend key or any other credential here.
# Anything that needs a privileged key is a Supabase Edge Function, and the key
# lives in Supabase Vault, read at call time.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
